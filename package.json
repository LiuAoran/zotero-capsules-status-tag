{
  "name": "zotero-capsules-status",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write \"src/*.js\" \"src/*.css\"",
    "check": "prettier --check \"src/*.js\" \"src/*.css\"",
    "release": "npm run build && python3 scripts/package-source.py && python3 scripts/prepare-downloads.py"
  },
  "dependencies": {
    "@material/material-color-utilities": "0.3.0"
  },
  "devDependencies": {
    "esbuild": "0.25.10",
    "prettier": "3.6.2"
  },
  "description": "Independent Material Design 3 reading-status capsules for Zotero 10",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/LiuAoran/zotero-capsules-status.git"
  }
}
